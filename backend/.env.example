# Every value below is the default; the backend runs with none of them set.

# --- Process ---
PORT=3000
# api = HTTP only, worker = resolver/pollers only, all = both in one process.
ROLE=all
# pino level: trace | debug | info | warn | error | silent
LOG_LEVEL=info

# --- Postgres ---
# DATABASE_URL is used for queries. On hosted Postgres (Supabase/Neon) behind a
# transaction pooler, LISTEN/NOTIFY needs a direct/session connection: set
# DATABASE_LISTEN_URL to it. Falls back to DATABASE_URL when empty.
DATABASE_URL=postgres://reconcile:reconcile@localhost:5433/reconcile
DATABASE_LISTEN_URL=

# --- Upstream services ---
PSP_A_URL=http://localhost:4001
PSP_B_URL=http://localhost:4002
# Person A's bank mock. For local dev without it, `pnpm dev` points this at
# stub PSP A (http://localhost:4001), which also serves /statements.
BANK_URL=http://localhost:4003

# HMAC secrets for X-Signature on incoming webhooks; must match the PSPs'.
WEBHOOK_SECRET_PSP_A=dev-secret-psp-a
WEBHOOK_SECRET_PSP_B=dev-secret-psp-b

# --- Timings (ms) ---
# Outbound PSP call timeout; past it the payment is UNKNOWN, never FAILED.
PSP_TIMEOUT_MS=3000
# Status polling backoff: min(POLL_BASE_MS * 2^poll_count, POLL_MAX_MS).
POLL_BASE_MS=2000
POLL_MAX_MS=60000
# How long a NOT_FOUND answer is tolerated before re-sending with the same key.
NOT_FOUND_GRACE_MS=30000
# No terminal evidence by then → UNRESOLVED review case, polling stops.
PAYMENT_DEADLINE_MS=600000
# Succeeded with no settlement line after this → SETTLEMENT_MISSING.
SETTLEMENT_WINDOW_MS=300000
# Settled with no bank credit after this → BANK_NOT_CREDITED.
BANK_WINDOW_MS=300000
# Settlement and bank CSV poll interval.
CSV_POLL_MS=30000
# Worker sweep interval (the correctness backstop for lost notifications).
SWEEP_MS=15000
# Same customer + amount on another order within this → SUSPECTED_DUPLICATE.
SUSPECT_WINDOW_MS=120000

# Refund the later charge of a DOUBLE_CHARGE automatically (key refund:<pspRef>).
AUTO_REFUND_DUPLICATES=false

# Allowed browser origin for the frontend (e.g. https://your-frontend.example).
CORS_ORIGIN=*
