# Server
PORT=3000
ROLE=all

# Postgres — DATABASE_URL is used for queries. On hosted Postgres (Supabase/Neon)
# with a transaction pooler, LISTEN/NOTIFY requires a direct/session connection:
# set DATABASE_LISTEN_URL to that direct connection string. Falls back to
# DATABASE_URL if unset (fine for local docker-compose Postgres).
DATABASE_URL=postgres://reconcile:reconcile@localhost:5433/reconcile
DATABASE_LISTEN_URL=

# Upstream services
PSP_A_URL=http://localhost:4001
PSP_B_URL=http://localhost:4002
BANK_URL=http://localhost:4003

WEBHOOK_SECRET_PSP_A=dev-secret-psp-a
WEBHOOK_SECRET_PSP_B=dev-secret-psp-b

# Timings (ms)
PSP_TIMEOUT_MS=3000
POLL_BASE_MS=2000
POLL_MAX_MS=60000
NOT_FOUND_GRACE_MS=30000
PAYMENT_DEADLINE_MS=600000
SETTLEMENT_WINDOW_MS=300000
BANK_WINDOW_MS=300000
CSV_POLL_MS=30000
SWEEP_MS=15000
SUSPECT_WINDOW_MS=120000

AUTO_REFUND_DUPLICATES=false

CORS_ORIGIN=*
