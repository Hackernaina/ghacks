# --- Dev server proxy targets (read by vite.config.ts, never sent to the browser) ---
BACKEND_URL=http://localhost:3000
PSP_A_URL=http://localhost:4001
PSP_B_URL=http://localhost:4002
BANK_URL=http://localhost:4003

# --- Static build (baked in at `vite build`) ---
# Leave empty to call the same origin (dev proxy, or a reverse proxy in front of both).
# Set to the deployed backend URL when the frontend is hosted separately; then set
# the backend's CORS_ORIGIN to the frontend's origin.
VITE_API_URL=
# Fault-injection targets for the ops dashboard. The mocks must allow CORS from the frontend origin.
VITE_MOCK_A_URL=
VITE_MOCK_B_URL=
VITE_MOCK_BANK_URL=
